# One process = one ABRA company. Use a dedicated API account with read permissions.
# Keep this file outside chat prompts. cp .env.example .env then chmod 600 .env.
# Leave all four FLEXI_* connection variables unset for legislation-only operation.
FLEXI_BASE_URL=https://your-company.flexibee.eu:5434
FLEXI_COMPANY=your_company
FLEXI_USERNAME=mcp_reader
FLEXI_PASSWORD=replace_locally
FLEXI_CONNECTION_NAME=main
FLEXI_ALLOWED_EVIDENCES=faktura-vydana,faktura-prijata
# Use * for all readable registers and runtime-schema fields, including items,
# accounting journal and VAT classifications. Credential/config stores stay blocked.
# FLEXI_ALLOWED_EVIDENCES=*
FLEXI_TIMEOUT_MS=15000
FLEXI_MAX_RESPONSE_BYTES=1048576

# Use an absolute path when your MCP host starts the process outside this repo.
MCP_AUDIT_PATH=.state/audit.jsonl
MCP_CALLS_PER_MINUTE=60

# Both must be set together after a corpus is reviewed and published.
# CZLAW_CORPUS_PATH=/absolute/path/to/release/manifest.json
# CZLAW_MANIFEST_SHA256=exact_64_character_lowercase_sha256
CZLAW_MAX_AGE_DAYS=7

# Multi-server mode (mutually exclusive with legacy routing above):
# FLEXI_CONFIG_PATH=/absolute/path/to/connections.json
# Comment out FLEXI_BASE_URL, FLEXI_COMPANY and FLEXI_CONNECTION_NAME.
# Keep credential env vars referenced by config/connections.example.json.
