{
  "name": "@glux/mcp-flexibee",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only ABRA Flexi MCP connector and versioned Czech legislation retrieval",
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "bin": { "mcp-flexibee": "dist/index.js" },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "node src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "npm run build && node --test test/*.test.ts",
    "check": "npm run typecheck && npm test",
    "smoke:flexi": "node --env-file=.env scripts/smoke-flexi.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "26.6.5",
    "typescript": "6.0.3"
  }
}
